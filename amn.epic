/* amnesiac by crapple(zak), kreca and skullY
pr0pz and thanks go to void!, xavier!, fudd, BlackJac, hop, criminal, krimson,
violence, skullY, Alien88, kreca, adam, ryan, sirko, klepto, david, wicked
bioterror(mongoose), byron and any others out there who have helped out.
*/

if (word(2 $loadinfo()) != [pf]) {
	load -pf $word(1 $loadinfo());
	return;
};

if (word(0 $info(v)) != [epic6] || info(i) < 3117) {
	xecho -b Amnesiac has detected an old version of epic;
	xecho -b Required version is EPIC6 revision 3117 or newer;
	xecho -b override check: comment check in amn.epic at own risk!;
	return;
};

package amnesiac;

## dump all
dump all;
timer -del all;
for array in ($getarrays()) {
        @ delarray($array);
};


## static vars for savefiles.
@savepath='~/.amn/';

###### TOUCH BELOW THIS LINE AND YOU DESERVE WHATEVER YOU GET, SUCKA. ######
@savefile='a.save';
@fsavefile='a.fsave';
@setsavefile='a.settings';
@igsfile='a.ig.save';
@csavefile='a.csave';
@fsetsavefile='a.fsetsave';
@modfile='mod.save';

@savefiles="$savefile $fsavefile $igsfile $csavefile $fsetsavefile $modfile";
@format_strings='action action_other desc send_desc away banner kick leave join signoff msg send_msg public send_public public_other notice send_notice public_notice ctcp send_ctcp ctcp_reply mode nick_comp nickname wall bwall who who_footer timestamp_some topic notopic settopic topicby statusbar version_reply whois scan';

## load comptability functs
@loadpath="$before(-1 / $word(1 $loadinfo()))/";

## supported modules
@_modules='ncomp abot aol query away mjoin oper relaysmtp tab tc userlist mmatrix vanilla nlog services urlgrab utf8 eoper elog';
@_defaultmods='away tab';

#progress bar
@_pcnt=0;
alias _progress {
	@_pcnt=_pcnt+1;
	set input_prompt $(hblk)[$cparse($(c1)$[20]repeat($_pcnt ?))$(hblk)] [$(cl)${_pcnt*2}$(hwht)%$(hblk)];
};

## unset/set cosmetic crap
set -status_user;
set -status_format1;
set -status_format2;

## set def win levels/name
window 1 level none;
window 1 name -;

## proper yell silence. as we do not want to silence all
on ^yell "File not found*" #;
on ^yell "*INFO*" #;
on ^yell "% *Mode parser or server*" #;

## NOTE: when loading something in a particular order,
## make sure its unset on coreload so it doesnt get reloaded
## around line 120 as of this writing.

## Compatibility and addset functions
load -pf $(loadpath)core/compat.m;
load -pf $(loadpath)core/addsets.m;

## load default settings. Overriden in ~/.amn/
load -pf $(loadpath)defaults/settings.default;
load -pf $(loadpath)defaults/fset.default;

_progress;
load -pf $(loadpath)core/save.m;
load -pf $(loadpath)core/main.m;
load -pf $(loadpath)core/config.m;

## Load the commands used by the saved ignore rules and notify list.
load -pf $(loadpath)core/ignore.m;
load -pf $(loadpath)core/notify.m;

## load savefiles.
if (left(1 $word(2 $stat("$(savepath)"))) != [4] && mkdir("$(savepath)") != 0) {
	xecho $acban Could not create directory $(savepath);
} elsif (chmod("$(savepath)" 700) != 0) {
	xecho $acban Could not set permissions on $(savepath);
};

## Load saved settings and state. The module loader reads mod.save.
@_amn_starting = 1;
@_amn_legacy_saves = 0;
@_amn_loading_saved_state = 1;
fe ($remw($modfile $savefiles)) ff {
	if (@word(2 $stat("$(savepath)$ff"))) {
		save.read "$(savepath)$ff";
	};
};

@_amn_loading_saved_state = 0;
_ntfy_sync_all;

_progress;

if (fke6 == [dcc]) {
	@fke6 = [];
};

## List the bundled formats so startup also works from a ZIP.
fe (action away banner channel ctcp kick messages misc mode nickname notice publics scan statusbar topic whois) category {
	load -pf $(loadpath)format/$category/config.m;
};

## Load the remaining bundled core scripts in filename order.
fe (action alias bind chanmodes color country exec format fsets help history hooks linedrawing mod modeshow netsplit paste reconnect scan server theme trickle wall window) mod {
	load -pf $(loadpath)core/$(mod).m;
	_progress;
};

## load default modules
_modload;

_progress;

# Load settings file here. Modules might add their own sets
if (@word(2 $stat("$(savepath)$setsavefile"))) {
   save.read "$(savepath)$setsavefile";
};

@_amn_starting = 0;
if (_amn_legacy_saves) {
	xecho -v $acban Run /save to upgrade legacy save files to PF format.;
};

## XXX hack to make Xavier happy. If the environment variable IRCNAME is set
## honour it and clear it. //kreca
@rname = getenv(IRCNAME);
if (@rname) {
	set default_realname $rname;
	setenv -IRCNAME;
};

## Comment for stoners: ^getusers is used when dump/reload while in a chan
## or loading after one connects to a server.
getusers;

format.init;

# Load Python support when EPIC6 was built with it.
if (getfunctions(PYTHON) != []) {
	load -pf python;
};

# We're finished, display ans.
load -pf $(loadpath)ans/startup.ans;

# Im not sure why we need wait here, but we do :) //kreca
wait;

_center Amnesiac/$a.rel \($a.snap\) [cvs \($a.commitid\)] for $(J) \($V\) [$info(i)] loaded..;
